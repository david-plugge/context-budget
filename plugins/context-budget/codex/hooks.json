{
    "hooks": {
        "PostToolUse": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"${PLUGIN_ROOT}/codex/budget.py\""
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"${PLUGIN_ROOT}/codex/budget.py\""
                    }
                ]
            }
        ],
        "PreCompact": [
            {
                "matcher": "^auto$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"${PLUGIN_ROOT}/codex/budget.py\""
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "matcher": "^compact$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"${PLUGIN_ROOT}/codex/budget.py\""
                    }
                ]
            }
        ]
    }
}
